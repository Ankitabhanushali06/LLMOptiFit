# ==============================================================================
# LLMOptiFit — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your Nebius Token Factory API key:
#   cp .env.example .env
#
# Obtain your key from: https://tokenfactory.nebius.com/
# ==============================================================================

NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Public web generation uses the owner's key above. Disabled by default.
# Enabling this lets visitors consume your Nebius balance and may incur charges.
# Request limits cannot guarantee a $0 bill. Configure provider billing first.
GENERATION_ENABLED=false
